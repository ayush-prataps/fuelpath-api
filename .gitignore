*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Django ─────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
mediafiles/

# ── Environment / secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Testing ─────────────────────────────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db

# ── Ruff / linting ───────────────────────────────────────────────────────────
