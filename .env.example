# ── Django ─────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-before-committing-anything

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fuelpath
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── OSRM ───────────────────────────────────────────────────────────────────
# Public demo endpoint — swap for a self-hosted instance in production.
OSRM_BASE_URL=https://router.project-osrm.org

# ── Route / optimizer settings ─────────────────────────────────────────────
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10

# ── Geocoding (used only during CSV ingestion, not on the hot path) ─────────
GEOCODER_USER_AGENT=fuelpath-ingestion/1.0
